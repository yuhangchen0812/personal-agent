# Copy to .env locally. Keep credentials out of tracked files.
# Process environment > .env; CLI options override the current run.
DASHSCOPE_API_KEY=
# PERSONAL_AGENT_MODEL=qwen3.7-plus
# PERSONAL_AGENT_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/compatible-mode/v1
# PERSONAL_AGENT_MAX_TOKENS=1024
# PERSONAL_AGENT_THINKING=disabled
# Set a budget only with enabled thinking; keep it below the output limit.
# PERSONAL_AGENT_THINKING_BUDGET=256

# Native Anthropic Messages
# PERSONAL_AGENT_PROTOCOL=anthropic
# ANTHROPIC_PROVIDER=native
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_THINKING=disabled
# ANTHROPIC_MAX_TOKENS=4096
# Native enabled thinking requires budget >=1024 and below max tokens.
# ANTHROPIC_THINKING_BUDGET=1024

# Explicit Qwen Messages profile reuses DASHSCOPE_API_KEY.
# PERSONAL_AGENT_PROTOCOL=anthropic
# ANTHROPIC_PROVIDER=qwen
# ANTHROPIC_MODEL=qwen3.7-plus
